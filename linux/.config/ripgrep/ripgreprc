# Ripgrep Config

# Ignore patterns
--glob=!.git/*
--glob=!node_modules/*
--glob=!vendor/*
--glob=!*.lock
--glob=!package-lock.json
--glob=!yarn.lock
--glob=!pnpm-lock.yaml
--glob=!dist/*
--glob=!build/*
--glob=!.next/*
--glob=!target/*

# Smart case (case-insensitive unless uppercase in pattern)
--smart-case

# Line number
--line-number

# Colors (Gruvbox theme)
--colors=line:fg:0xeb,0xdb,0xb2
--colors=match:fg:0xfb,0x49,0x34
--colors=match:bg:0x3c,0x38,0x36
--colors=match:style:bold
--colors=path:fg:0x83,0xa5,0x98
--colors=column:fg:0x92,0x83,0x74

# Search hidden files
--hidden